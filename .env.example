# Kalari CRM — environment contract. COMMITTED. Never put real values here.
# Copy to `.env` and fill in. `.env` is gitignored.

# ── Supabase (browser-visible; safe — the anon key is RLS-gated and anon holds no grants) ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ── Server-only. Bypasses RLS entirely. Never import into a client component. ──
# src/lib/supabase/admin.ts is marked `import "server-only"` so a client import is a build error.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Tooling: the Supabase CLI reads SUPABASE_ACCESS_TOKEN for auth ──
SUPABASE_ACCESS_TOKEN=<sbp_...>
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_PASSWORD=<db-password>

# ── PII (ARCHITECTURE.md §4: passport_no encrypted at rest, every read logged) ──
# AES-256-GCM key, base64. The key lives HERE, never in Postgres — read_customer_passport()
# returns ciphertext and decryption happens in Node, so a leaked service_role key is not
# sufficient to decrypt passports.
#
# KEY ESCROW IS MANDATORY. These two values are in no backup, no PITR restore, and no
# database dump. Lose them and every passport is unrecoverable, permanently.
# DO NOT ROTATE either value while ciphertext encrypted under it still exists —
# invoices.key_version supports versioned rotation; do it that way, not by replacement.
PII_ENCRYPTION_KEY=<base64-32-bytes>
# HMAC pepper for the blind index (exact-match passport lookup without decrypting).
PII_HASH_PEPPER=<base64-32-bytes>

# ── App ──
INVOICE_OVERDUE_DAYS=7
# Informational only. Never rely on process.env.TZ for date logic — a platform can override
# it and a serverless function may not inherit it. Use today_kolkata() in SQL and
# src/lib/dates.ts (Intl with timeZone: 'Asia/Kolkata') in TypeScript. ARCHITECTURE.md §3.29.
TZ=Asia/Kolkata

# ── Cron workers (Phase 5). Shared secret pg_net sends as a header; store in Supabase Vault. ──
CRON_SECRET=<random-32-bytes>

# ── Lead intake (Phase 2). Bearer token the website lead form posts with. ──
LEADS_INTAKE_TOKEN=<random-32-bytes>

# ── Email (Phase 5). Provider SDK is imported in exactly one file: lib/email/adapters/. ──
EMAIL_PROVIDER=console
RESEND_API_KEY=<re_...>
EMAIL_FROM="Kalari Tours and Travels <noreply@kalaritravels.in>"

# ── Public site URL, for portal links in emails ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
